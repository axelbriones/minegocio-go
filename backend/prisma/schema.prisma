generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]
  sales     Sale[]
  purchases Purchase[]
  stockMovements StockMovement[]
}

model Product {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  barcode     String?
  imageUrl    String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  saleItems   SaleItem[]
  purchaseItems PurchaseItem[]
  stockMovements StockMovement[]

  @@index([userId])
  @@index([barcode])
  @@index([name])
}

model Sale {
  id        String   @id @default(uuid())
  userId    String
  total     Float
  paymentMethod String @default("CASH") // CASH, CARD, TRANSFER, CREDIT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  items     SaleItem[]

  @@index([userId])
  @@index([createdAt])
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  price     Float

  sale      Sale     @relation(fields: [saleId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Purchase {
  id        String   @id @default(uuid())
  userId    String
  total     Float
  supplier  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  items     PurchaseItem[]

  @@index([userId])
  @@index([createdAt])
}

model PurchaseItem {
  id        String   @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Int
  cost       Float

  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

model StockMovement {
  id        String   @id @default(uuid())
  userId    String
  productId String
  type      String   // IN, OUT, ADJUSTMENT
  quantity  Int
  reason    String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
  @@index([createdAt])
}
