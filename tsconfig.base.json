{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@shared/*": ["shared/*"],
      "@ui/*": ["ui/*"],
      "@api/*": ["api/*"],
      "@core/*": ["core/*"]
    }
  }
}
