generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  roles             Role[]
  warehouses        Warehouse[]
  categories        Category[]
  brands            Brand[]
  units             Unit[]
  products          Product[]
  transfers         InventoryTransfer[]
  suppliers         Supplier[]
  customers         Customer[]
  sales             Sale[]
  purchases         Purchase[]
  recommendations   AIRecommendation[]
  notifications     Notification[]
  auditLogs         AuditLog[]
}

model Role {
  id        String   @id @default(uuid())
  companyId String
  name      String   // ADMINISTRATOR, SUPERVISOR, WAREHOUSE, SELLER, AUDITOR

  company   Company  @relation(fields: [companyId], references: [id])
  users     User[]
}

model User {
  id        String   @id @default(uuid())
  companyId String
  roleId    String?
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id])
  role      Role?    @relation(fields: [roleId], references: [id])

  movements InventoryMovement[]
  transfers InventoryTransfer[]
  sales     Sale[]
  purchases Purchase[]
  notifications Notification[]
  auditLogs AuditLog[]
}

model Warehouse {
  id        String   @id @default(uuid())
  companyId String
  name      String
  code      String?
  address   String?
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE

  company   Company  @relation(fields: [companyId], references: [id])
  inventories Inventory[]
  movements   InventoryMovement[]
  transfersFrom InventoryTransfer[] @relation("SourceWarehouse")
  transfersTo   InventoryTransfer[] @relation("DestinationWarehouse")
  sales         Sale[]
  purchases     Purchase[]
}

model Category {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  parentId    String?
  color       String?
  icon        String?

  company     Company    @relation(fields: [companyId], references: [id])
  parent      Category?  @relation("Subcategories", fields: [parentId], references: [id])
  subcategories Category[] @relation("Subcategories")
  products    Product[]
}

model Brand {
  id        String   @id @default(uuid())
  companyId String
  name      String

  company   Company  @relation(fields: [companyId], references: [id])
  products  Product[]
}

model Unit {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  abbreviation String

  company      Company  @relation(fields: [companyId], references: [id])
  products     Product[]
}

model Product {
  id           String   @id @default(uuid())
  companyId    String
  sku          String?
  barcode      String?
  qr           String?
  name         String
  description  String?
  categoryId   String?
  brandId      String?
  unitId       String?

  averageCost  Float?   @default(0)
  lastCost     Float?   @default(0)
  price        Float    @default(0)
  minPrice     Float?

  minStock     Int?     @default(0)
  maxStock     Int?
  reorderPoint Int?

  weight       Float?
  volume       Float?
  image        String?
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company  @relation(fields: [companyId], references: [id])
  category     Category? @relation(fields: [categoryId], references: [id])
  brand        Brand?   @relation(fields: [brandId], references: [id])
  unit         Unit?    @relation(fields: [unitId], references: [id])

  inventories  Inventory[]
  movements    InventoryMovement[]
  batches      Batch[]
  serialNumbers SerialNumber[]
  saleItems    SaleItem[]
  purchaseItems PurchaseItem[]
}

model Inventory {
  id             String   @id @default(uuid())
  productId      String
  warehouseId    String
  currentStock   Int      @default(0)
  reservedStock  Int      @default(0)
  availableStock Int      @default(0)

  product        Product  @relation(fields: [productId], references: [id])
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
}

model InventoryMovement {
  id             String   @id @default(uuid())
  productId      String
  warehouseId    String
  userId         String
  type           String   // IN, OUT, ADJUSTMENT, TRANSFER, RETURN, SALE, PURCHASE
  quantity       Int
  date           DateTime @default(now())
  sourceDocument String?
  remarks        String?

  product        Product  @relation(fields: [productId], references: [id])
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
}

model InventoryTransfer {
  id                     String   @id @default(uuid())
  companyId              String
  sourceWarehouseId      String
  destinationWarehouseId String
  status                 String   // PENDING, COMPLETED, CANCELLED
  userId                 String
  detail                 String?
  createdAt              DateTime @default(now())

  company                Company  @relation(fields: [companyId], references: [id])
  sourceWarehouse        Warehouse @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse   Warehouse @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  user                   User     @relation(fields: [userId], references: [id])
}

model Batch {
  id                String   @id @default(uuid())
  productId         String
  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime?
  quantity          Int

  product           Product  @relation(fields: [productId], references: [id])
}

model SerialNumber {
  id           String   @id @default(uuid())
  productId    String
  serialNumber String   @unique
  status       String   // AVAILABLE, SOLD, RESERVED, DEFECTIVE

  product      Product  @relation(fields: [productId], references: [id])
}

model Supplier {
  id        String   @id @default(uuid())
  companyId String
  name      String
  contact   String?
  phone     String?
  email     String?

  company   Company  @relation(fields: [companyId], references: [id])
  purchases Purchase[]
}

model Customer {
  id        String   @id @default(uuid())
  companyId String
  name      String
  document  String?
  phone     String?
  email     String?

  company   Company  @relation(fields: [companyId], references: [id])
  sales     Sale[]
}

model Sale {
  id          String   @id @default(uuid())
  companyId   String
  warehouseId String
  customerId  String?
  userId      String
  totalAmount Float
  paymentType String   @default("Efectivo")
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  items       SaleItem[]
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  price     Float

  sale      Sale     @relation(fields: [saleId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Purchase {
  id          String   @id @default(uuid())
  companyId   String
  warehouseId String
  supplierId  String?
  userId      String
  totalAmount Float
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  items       PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Int
  cost       Float

  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

model AIRecommendation {
  id        String   @id @default(uuid())
  companyId String
  type      String   // STOCK_OUT_RISK, OVERSTOCK, SLOW_MOVING, PURCHASE_REC, ANOMALY
  payload   Json
  status    String   @default("PENDING") // PENDING, APPLIED, DISMISSED
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  action    String
  module    String
  date      DateTime @default(now())
  ip        String?
  payload   Json?

  company   Company  @relation(fields: [companyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model SyncEvent {
  id        String   @id @default(uuid())
  entity    String   // Any module entity
  entityId  String
  action    String   // CREATE, UPDATE, DELETE
  payload   Json
  status    String   @default("PENDING")
  error     String?
  createdAt DateTime @default(now())
}
